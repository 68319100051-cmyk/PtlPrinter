# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE FIRESTORE CONFIGURATION (REQUIRED FOR VERCEL DEPLOYMENT)
# Copy these values from Firebase Console -> Project Settings -> General -> Your apps (Web)
# ==============================================================================
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
# Optional:
VITE_FIREBASE_MEASUREMENT_ID=""
# Optional (leave empty or "(default)" for standard Firebase Firestore):
VITE_FIREBASE_DATABASE_ID=""
