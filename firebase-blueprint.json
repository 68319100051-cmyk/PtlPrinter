{
  "entities": {
    "PawnContract": {
      "title": "PawnContract",
      "description": "A pawn or consignment contract record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "loanAmount": { "type": "number" },
        "monthlyInterestRate": { "type": "number" },
        "status": { "type": "string" },
        "dueDate": { "type": "string" },
        "startDate": { "type": "string" }
      },
      "required": ["id", "contractNumber", "loanAmount", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer personal profile for AG Customer Intelligence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "citizenId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "citizenId"]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Store configuration and stepped interest tiers",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["shopName"]
    },
    "SecondhandBuyIn": {
      "title": "SecondhandBuyIn",
      "description": "Secondhand inventory bought in for retail sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyInNumber": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "buyInNumber", "purchasePrice", "status"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Staff user accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    }
  },
  "firestore": {
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/PawnContract" },
      "description": "Active and completed pawn contracts"
    },
    "/archived_contracts/{contractId}": {
      "schema": { "$ref": "#/entities/PawnContract" },
      "description": "Archived closed contracts"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer records"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/ShopSettings" },
      "description": "Shop and business settings"
    },
    "/secondhand_buyins/{itemId}": {
      "schema": { "$ref": "#/entities/SecondhandBuyIn" },
      "description": "Secondhand retail items"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Staff and admin accounts"
    }
  }
}
